# PeptideHormone — environment variables
#
# Copy this file to .env.local and fill in real values, or set the same
# variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit .env.local — only this template is tracked (see .gitignore).
#
# Run `npm run check:pass` to validate the Research Pass / Stripe / Resend / KV
# values (it live-checks the keys without printing any secret).

# ── Research agent (/research) ───────────────────────────────────────────────
# Required for the research agent. Without it /api/chat returns 500.
ANTHROPIC_API_KEY=sk-ant-...
# Reasoning effort for the agent: low | medium | high | max. Default: medium.
AGENT_EFFORT=medium
# Set to 1 to log agent debug output. Default: off.
AGENT_DEBUG=

# ── Research Pass metering ───────────────────────────────────────────────────
# HMAC key signing the quota cookie, the pass cookie, and minted codes.
# Unset → metering is OFF entirely (no quota, no paywall, codes cannot be minted).
# Use 32+ random chars, e.g. `openssl rand -base64 32`. Keep it STABLE: rotating
# it invalidates every issued pass cookie and every emailed code.
PASS_SECRET=
# Free questions per UTC day before the paywall. Default: 5.
PASS_FREE_DAILY=5
# Comma-separated admin/complimentary codes that always redeem (in addition to
# purchased codes). Optional.
PASS_CODES=
# Where the "Get a Research Pass" button sends readers. Use /research/pass for the
# embedded checkout, or an absolute URL (e.g. a Stripe Payment Link). Unset → the
# paywall shows the code box only, no button.
PASS_CHECKOUT_URL=/research/pass

# ── Stripe checkout (/research/pass) ─────────────────────────────────────────
# Publishable + secret keys MUST be the same mode (both test, or both live), or
# the embedded form mounts blank. From https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the /api/stripe-webhook endpoint. Unset → the webhook accepts
# UNSIGNED events (fine locally, never in production).
# From https://dashboard.stripe.com/workbench/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Overrides the Price ID hard-coded in src/app/api/create-checkout-session/route.ts.
# Required when using test keys (the code default is a live-mode Price): create a
# test-mode Price and set it here. Must match the key mode above.
STRIPE_PRICE_ID=

# ── Fulfilment email (Resend) ────────────────────────────────────────────────
# Both must be set to email purchased codes; otherwise codes are only logged for
# manual delivery (checkout still succeeds).
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sender address on a domain VERIFIED in Resend (the local part is arbitrary).
PASS_EMAIL_FROM=pass@peptidehormone.com
# Optional reply-to address (e.g. a monitored inbox).
PASS_EMAIL_REPLY_TO=

# ── Single-use codes (Vercel KV / Upstash Redis) ─────────────────────────────
# Makes each purchased code redeemable exactly once. Unset → codes are REUSABLE.
# Vercel KV (Storage → Create → KV) sets KV_REST_API_*; Upstash sets UPSTASH_*.
# Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Site / SEO (optional) ────────────────────────────────────────────────────
# Base URL used by the Stripe webhook when building the research-agent link in the
# pass email. Default: https://peptidehormone.com
NEXT_PUBLIC_SITE_URL=https://peptidehormone.com
# Google Search Console "HTML tag" verification token. Optional.
GOOGLE_SITE_VERIFICATION=

# ── Build / data scripts (optional) ──────────────────────────────────────────
# Used by scripts/ping-indexnow.mjs; defaults to the key file committed in public/.
# INDEXNOW_KEY=
# SITE_URL=https://peptidehormone.com
# Lifts the openFDA rate limit for scripts/fetch-adverse-events.mjs. Optional.
# OPENFDA_API_KEY=
